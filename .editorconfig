root = true

# 统一编辑器行为，避免"改一行、整文件重排"的噪音 diff
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml,json,md,toml}]
indent_size = 2

[*.{html,css,js}]
indent_size = 2

# Windows 批处理必须是 CRLF，且只允许 ASCII（见 启动DSHQuant.cmd 顶部注释）
[*.{bat,cmd}]
end_of_line = crlf
charset = latin1

[Makefile]
indent_style = tab
