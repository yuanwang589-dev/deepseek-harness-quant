# 回测策略外部注册表（★动态化铁律：新增/调整策略 = 改本文件，不改代码）
# 加载：backtest/bt_runner.py 启动时合并进内置注册表（同名覆盖内置）。
# 策略类型：
#   instant: true  → 即时回测（评分方式二选一）
#       factor_list: 声明式因子组合（factors/factor_engine.py FACTOR_FUNCS 动态合成，sign=+1 正向 / -1 反转）
#       scorer: 内置评分函数名（tech3 / script1 / turn_low）
#   instant: false → 批处理（如 factor_all），运行按钮禁用
extra:
  lowvol_defense:
    name: 低波防守单因子
    category: 策略
    instant: true
    desc: "声明式策略示例：lowvol_60 反转单因子（外部配置注册，零代码）"
    factors: ["lowvol_60"]
    factor_list:
      - name: lowvol_60
        sign: -1
    defaults:
      topn: 10
      stocks: 300
    rebalance: M
# 评分阈值 / 权重 / 配额（得分引擎读取；复制到 strategies.yaml 后按需调整）
scoring:
  type_weights:
    reversal:     { w_gains: 0.30, w_prob: 0.35, w_safety: 0.35 }
    value:        { w_gains: 0.30, w_prob: 0.30, w_safety: 0.40 }
    breakout:     { w_gains: 0.45, w_prob: 0.25, w_safety: 0.30 }
    revalue:      { w_gains: 0.45, w_prob: 0.35, w_safety: 0.20 }
    event:        { w_gains: 0.30, w_prob: 0.40, w_safety: 0.30 }
    quality_gap:  { w_gains: 0.30, w_prob: 0.30, w_safety: 0.40 }
    pv_consensus: { w_gains: 0.25, w_prob: 0.35, w_safety: 0.40 }
  pitch_gate:
    reversal: 80
    value: 62
    breakout: 72
    revalue: 70
    event: 68
    quality_gap: 62
    pv_consensus: 68
  winrate_mult:
    quality_gap: 1.311
    value: 1.164
    revalue: 0.999
    pv_consensus: 0.993
    event: 0.959
    breakout: 0.848
    reversal: 0.726
  consensus_bonus: { 2: 3.0, 3: 6.0, 4: 9.0, 5: 3.0, 6: 6.0, 7: 8.0, 8: 10.0, 9: 12.0, 10: 14.0 }
  size_tier_large: 1000.0
  size_tier_mid: 300.0
  top_buy:
    timing_min: 75.0
    level: "适合买入"
    score_pad: 10.0
    types: [quality_gap, value]
  tier_slots: { 大盘: 2, 中盘: 2, 小盘: 1 }
  otype_slots:
    revalue: 2
    value: 2
    quality_gap: 3
    event: 2
    reversal: 1
    breakout: 1
    pv_consensus: 1
  ref_types: [quality_gap, value]
